@page "/"
@using BlazorRagAssistant.Services
@inject RagService RagService
@rendermode InteractiveServer

<PageTitle>AI Knowledge Base Assistant</PageTitle>

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🤖 Knowledge Base AI Assistant (RAG PoC)</h5>
        </div>
        <div class="card-body bg-light" style="height: 350px; overflow-y: auto;">
            @if (!string.IsNullOrEmpty(aiAnswer))
            {
                <div class="p-3 bg-white rounded border mb-3">
                    <strong>Assistant:</strong>
                    <p class="mb-0 mt-1 text-secondary">@aiAnswer</p>
                </div>
                
                @if (showContext && !string.IsNullOrEmpty(retrievedContext))
                {
                    <div class="p-2 bg-warning-subtle text-warning-dark rounded border small text-muted">
                        <strong>Source Context Used by Model:</strong>
                        <pre class="mb-0 mt-1" style="white-space: pre-wrap; font-size: 0.8rem;">@retrievedContext</pre>
                    </div>
                }
            }
            else if (isLoading)
            {
                <div class="text-center mt-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Scanning internal files and generating answer...</p>
                </div>
            }
            else
            {
                <p class="text-center text-muted mt-5">Ask a question about player registrations or uniforms to test the context retrieval!</p>
            }
        </div>
        <div class="card-footer">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Type your question..." @bind="userQuery" @bind:event="oninput" @onkeyup="HandleKeyUp" disabled="@isLoading" />
                <button class="btn btn-primary" type="button" @onclick="SubmitQuery" disabled="@isLoading">Submit</button>
            </div>
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="contextCheck" @bind="showContext">
                <label class="form-check-label small text-muted" for="contextCheck">
                    Show injected reference context (Debug mode)
                </label>
            </div>
        </div>
    </div>
</div>

@code {
    private string userQuery = "";
    private string aiAnswer = "";
    private string retrievedContext = "";
    private bool isLoading = false;
    private bool showContext = true;

    // 1. Inject the standard circuit state provider
    [Inject] private NavigationManager NavManager { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 2. Only run this when the page becomes fully interactive in the browser
        if (firstRender)
        {
            await RagService.InitializeKnowledgeBaseAsync();
            StateHasChanged(); // Let the UI know initialization finished smoothly
        }
    }

    private async Task SubmitQuery()
    {
        if (string.IsNullOrWhiteSpace(userQuery)) return;

        isLoading = true;
        aiAnswer = "";
        StateHasChanged();

        var result = await RagService.AskQuestionAsync(userQuery);
        aiAnswer = result.Answer;
        retrievedContext = result.ContextUsed;

        userQuery = "";
        isLoading = false;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitQuery();
        }
    }
}